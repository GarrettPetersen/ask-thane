# Cloudflare (local CLI use)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Cloudflare (GitHub Environments secrets; set in repo settings, not loaded by app code)
STAGING_CLOUDFLARE_ACCOUNT_ID=
STAGING_CLOUDFLARE_API_TOKEN=
PRODUCTION_CLOUDFLARE_ACCOUNT_ID=
PRODUCTION_CLOUDFLARE_API_TOKEN=
STAGING_D1_DATABASE_ID=
PRODUCTION_D1_DATABASE_ID=

# AI providers
OPENAI_API_KEY=
OPENAI_ADMIN_API_KEY=
OPENAI_ORGANIZATION_ID=
ANTHROPIC_API_KEY=
DEFAULT_LLM_PROVIDER=openai
DEFAULT_LLM_MODEL=gpt-5.4-mini
FREE_TIER_LLM_MODEL=gpt-4.1-mini
PAID_TIER_LLM_MODEL=gpt-5.4-mini
TEAM_TIER_LLM_MODEL=gpt-5.4-mini
GROWTH_TIER_LLM_MODEL=gpt-5.4
SCALE_TIER_LLM_MODEL=gpt-5.5
SCALE_PLUS_TIER_LLM_MODEL=gpt-5.5
PAID_TIER_DIGEST_LLM_MODEL=gpt-5.4-mini
FREE_TIER_MONTHLY_AI_CAP_USD=10
SUBSCRIPTION_PAGE_URL=https://payments.askthane.com/subscribe

# Messaging integrations
SLACK_SIGNING_SECRET=
SLACK_BOT_TOKEN=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_OAUTH_STATE_SECRET=
SLACK_REDIRECT_URI=
SLACK_BOT_SCOPES=channels:history,groups:history,channels:read,groups:read,im:read,mpim:read,chat:write,chat:write.public,im:write

# Optional split for separate Slack staging app and production app
SLACK_CLIENT_ID_STAGING=
SLACK_CLIENT_SECRET_STAGING=
SLACK_SIGNING_SECRET_STAGING=
SLACK_BOT_TOKEN_STAGING=
SLACK_OAUTH_STATE_SECRET_STAGING=
SLACK_REDIRECT_URI_STAGING=
SLACK_CLIENT_ID_PRODUCTION=
SLACK_CLIENT_SECRET_PRODUCTION=
SLACK_SIGNING_SECRET_PRODUCTION=
SLACK_BOT_TOKEN_PRODUCTION=
SLACK_OAUTH_STATE_SECRET_PRODUCTION=
SLACK_REDIRECT_URI_PRODUCTION=

TEAMS_APP_ID=
TEAMS_APP_PASSWORD=

# Thane Chat auth email
THANE_API_BASE_URL=https://api.askthane.com
# Set THANE_API_BASE_URL=local for local CLI-only auth that prints verification codes.
THANE_CLI_AUTH_SECRET=
THANE_CLI_AUTH_DEV_CODES=false
THANE_CLI_EMAIL_FROM="Thane <noreply@askthane.com>"
RESEND_API_KEY=

# Billing
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_TEAM_MONTHLY=
STRIPE_PRICE_GROWTH_MONTHLY=
STRIPE_PRICE_SCALE_MONTHLY=
STRIPE_PRICE_SCALE_PLUS_MONTHLY=
STRIPE_METER_NAME_ACTIVE_USERS=
STRIPE_METER_NAME_ACTIVE_CHANNELS=
STRIPE_METER_NAME_TASK_EVENTS=
STRIPE_METER_NAME_LLM_COST_USD=
STRIPE_METER_NAME_AI_OVERAGE_USD=
BILLING_E2E_ENABLED=false
BILLING_E2E_BASE_URL=https://payments-staging.askthane.com
BILLING_E2E_PLAN_TIER=team
BILLING_E2E_EMAIL=
BILLING_E2E_STRIPE_SECRET_KEY=
OPENAI_PRICE_PROMPT_PER_1K_USD=
OPENAI_PRICE_COMPLETION_PER_1K_USD=
OPENAI_PRICING_VERSION=
OPENAI_COST_RECONCILIATION_ENABLED=true
OPENAI_RECON_ALERT_THRESHOLD_PCT=10

# Product settings
REMINDER_CRON="*/15 * * * *"
THANE_BASE_URL=https://askthane.com
DEFAULT_ORGANIZATION_ID=org_0
ADMIN_TRIGGER_TOKEN=
ADMIN_HMAC_KEYS=
ADMIN_HMAC_MAX_SKEW_SECONDS=300

# Build metadata (normally injected by CI on deploy)
BUILD_ENV=local
BUILD_GIT_SHA=dev
BUILD_DEPLOYED_AT=local
