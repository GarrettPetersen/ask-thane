{
  "name": "@ask-thane/thane-cli",
  "version": "0.1.0",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "thane": "dist/index.js"
  },
  "files": [
    "dist",
    "scripts/postinstall.mjs",
    "package.json"
  ],
  "main": "dist/index.js",
  "types": "src/index.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "pnpm run build && node dist/index.js",
    "lint": "echo 'No lint task yet for @ask-thane/thane-cli'",
    "prepack": "pnpm run build",
    "postinstall": "node scripts/postinstall.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm run typecheck"
  }
}
