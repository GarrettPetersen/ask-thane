{
  "name": "@ask-thane/thane-cli",
  "version": "0.1.10",
  "type": "module",
  "description": "Terminal-native team chat for Thane workspaces.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GarrettPetersen/ask-thane.git",
    "directory": "apps/thane-cli"
  },
  "license": "UNLICENSED",
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "thane": "dist/index.js"
  },
  "files": [
    "dist",
    "scripts/postinstall.mjs",
    "README.md",
    "package.json"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "pnpm run build && node dist/index.js",
    "lint": "echo 'No lint task yet for @ask-thane/thane-cli'",
    "prepack": "pnpm run build",
    "postinstall": "node scripts/postinstall.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm run typecheck"
  }
}
