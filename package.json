{
  "name": "ask-thane",
  "private": true,
  "version": "0.1.0",
  "description": "AI-native conversational task tracking platform for Slack and enterprise messaging",
  "packageManager": "pnpm@9.12.2",
  "scripts": {
    "build": "turbo run build --filter=@ask-thane/landing",
    "build:all": "turbo run build",
    "check:migrations": "node scripts/check-d1-migrations-nondestructive.mjs",
    "landing:dev": "wrangler --cwd apps/landing dev",
    "landing:deploy": "wrangler --cwd apps/landing deploy",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:billing:e2e": "node scripts/billing-e2e-checkout-smoke.mjs",
    "dev:bot": "pnpm --filter @ask-thane/bot-worker dev",
    "dev:api": "pnpm --filter @ask-thane/api-worker dev",
    "dev:payments": "pnpm --filter @ask-thane/payments-worker dev",
    "dev:landing": "pnpm --filter @ask-thane/landing dev",
    "thane": "pnpm --silent --filter @ask-thane/thane-cli dev",
    "thane:build": "pnpm --filter @ask-thane/thane-cli build"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260508.0",
    "turbo": "^2.0.14",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5",
    "wrangler": "^4.17.0"
  }
}
